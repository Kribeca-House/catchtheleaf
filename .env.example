# Copy to .env for local runs, or set these on the Scaleway Serverless Container.
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catchtheleaf
DATABASE_SSL=false

# Object Storage. Leave S3_BUCKET empty to store images on local disk (development).
S3_BUCKET=
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: a custom domain or CDN in front of the bucket
MEDIA_PUBLIC_URL=

# Password-reset emails through Scaleway Transactional Email. Without these, reset links are printed to the log.
APP_URL=https://your-app-domain
TEM_SECRET_KEY=
TEM_PROJECT_ID=
TEM_REGION=fr-par
MAIL_FROM=noreply@your-verified-domain

# Tree identification (free key at https://my.plantnet.org). Optional.
PLANTNET_API_KEY=
PLANTNET_LANG=en

# Season dates, MM-DD, end is exclusive. Default: 1 Sep to 30 Nov.
SEASON_START=09-01
SEASON_END=12-01
